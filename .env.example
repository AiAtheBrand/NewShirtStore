# Public base URL for the product API.
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_API_URL=https://dummyjson.com

# Enable real order submission when a backend /orders endpoint is available.
# Keep false to avoid accidental submissions when no backend is configured.
VITE_ORDERS_ENABLED=false

# Enable server-backed cart persistence via /cart when using the FastAPI backend.
VITE_CART_API_ENABLED=false
